{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/api/*": ["./src/server/api/*"],
      "@/*": ["./src/*"],
      "@airo/content": ["./content-lib/src/index.ts"]
    },
    "baseUrl": "."
  },
  "include": ["src", "vite.config.ts", "plugins"],
  "exclude": [
    "src/lib/__tests__/airo-video-slots-reverse.test.ts",
    "src/lib/__tests__/format-overrides-plugin.test.ts",
    "src/lib/__tests__/format-overrides.test.ts"
  ]
}
